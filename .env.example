# Firebase web config — copy this file to `.env` and fill in the values from
# the Firebase console (Project settings > Your apps > Web app).
# The Firebase project does not exist yet: the quota account for Sprint 2 is
# expected Nov 19, 2026. Until these are filled in, the app runs the story
# fully and the AI features show a clear "not connected yet" state.
# NEVER commit a real .env — it is gitignored.

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Optional: reCAPTCHA v3 site key for the production App Check provider.
# Without it, App Check init is skipped (local dev uses the debug provider).
VITE_RECAPTCHA_V3_SITE_KEY=

# App Check debug token for the deployed demo — register the token in the
# Firebase console (App Check > Manage debug tokens) and paste its value here.
# The hackathon rules accept debug tokens. NEVER commit a real token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
